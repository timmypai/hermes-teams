{
  "_comment": "devflow 角色表與宣告式政策：install.py 依此設定 7 個 Hermes profile（default = Hermes）。",
  "gh": {
    "builder": "/opt/data/profiles/devops/gh",
    "reviewer": "/opt/data/profiles/reviewer/gh"
  },
  "policy": {
    "port_base": 18100,
    "card_chars": 600,
    "judge_chars": 2000,
    "adj_per_card": 2,
    "ship_patch_limit": 2,
    "runner_stale_seconds": 300,
    "runner_wait_seconds": 120,
    "max_review_rounds": 2,
    "max_epic_cards": 12,
    "max_diff_files": 30,
    "advisor_retry_seconds": 30,
    "advisor_max_retries": 6,
    "default_merge_method": "squash",
    "auto_plan_advisor": false,
    "plan_risk_mode": "off",
    "auto_flow_adj": false,
    "require_human_approval_for_protected": true,
    "require_allowed_scope": true,
    "max_role_prompt_chars": 12000,
    "default_test_paths": [
      "tests/**",
      "test/**",
      "**/*.test.*",
      "**/*.spec.*",
      ".devflow/ui/**",
      ".devflow/verify.sh"
    ],
    "card_executors": {
      "RES": [
        {"assignee": "researcher", "workspace": "scratch"},
        {"assignee": "devops", "workspace": "dir"},
        {"assignee": "reviewer", "workspace": "dir"}
      ]
    },
    "modes": {
      "deliver": {
        "allow_write": true,
        "require_scenarios": true,
        "require_ship": true,
        "allow_dev_cards": true,
        "delivery_card_kinds": ["DEV", "OPS", "SHIP"],
        "card_executors": {
          "RES": [
            {"assignee": "researcher", "workspace": "scratch"},
            {"assignee": "devops", "workspace": "dir"}
          ]
        },
        "res_assignees": ["researcher", "devops"],
        "res_workspaces": ["scratch", "dir"]
      },
      "investigate": {
        "allow_write": false,
        "require_scenarios": false,
        "require_ship": false,
        "allow_dev_cards": false,
        "delivery_card_kinds": ["RES"],
        "card_executors": {
          "RES": [
            {"assignee": "researcher", "workspace": "scratch"},
            {"assignee": "devops", "workspace": "dir"}
          ]
        },
        "res_assignees": ["researcher", "devops"],
        "res_workspaces": ["scratch", "dir"]
      },
      "review": {
        "allow_write": false,
        "require_scenarios": false,
        "require_ship": false,
        "allow_dev_cards": false,
        "delivery_card_kinds": ["RES", "SHIP"],
        "card_executors": {
          "RES": [
            {"assignee": "researcher", "workspace": "scratch"},
            {"assignee": "reviewer", "workspace": "dir"}
          ]
        },
        "res_assignees": ["researcher", "reviewer"],
        "res_workspaces": ["scratch", "dir"]
      }
    },
    "pipelines": {
      "deliver": {
        "steps": ["repro", "design", "implement", "ci", "review", "ship", "accept"],
        "default_start": "repro",
        "default_stop": "accept",
        "step_cards": {
          "repro": "RES",
          "design": "ARCH",
          "implement": ["DEV", "OPS"],
          "ship": "SHIP",
          "accept": "EPIC"
        }
      },
      "investigate": {
        "steps": ["repro", "accept"],
        "default_start": "repro",
        "default_stop": "accept",
        "step_cards": {
          "repro": "RES",
          "accept": "EPIC"
        }
      },
      "review": {
        "steps": ["review", "accept"],
        "default_start": "review",
        "default_stop": "accept",
        "step_cards": {
          "review": "RES",
          "accept": "EPIC"
        }
      }
    },
    "handoff_schemas": {
      "repro": {
        "required": ["root_cause", "evidence"],
        "optional": [
          "affected_paths", "non_goals", "open_questions",
          "recommendation", "findings", "sources", "risks", "unverified"
        ]
      },
      "design": {
        "required": ["decisions", "target_files"],
        "optional": ["interfaces", "non_goals", "risks", "allowed_scope", "file_plan", "pr_slices", "adr_markdown"]
      },
      "implement": {
        "required": ["pr_url", "head_sha", "tests"],
        "optional": ["published_pr", "changed_files", "followups"]
      },
      "implement_local": {
        "required": ["branch", "head_sha", "tests", "changed_files"],
        "optional": ["base_ref", "summary", "followups"]
      },
      "ship": {
        "required": [],
        "required_when": [
          {"when": {"shipped": false}, "required": ["reason"]},
          {"default": true, "required": ["merged_sha"]}
        ],
        "optional": [
          "shipped", "reason", "merged_sha", "deployed_sha",
          "deploy_run_url", "integration_run_url", "acceptance_report", "verify", "followups"
        ]
      }
    }
  },
  "worker_config": {
    "agent.max_turns": "150",
    "agent.run_budget_seconds": "2400",
    "terminal.timeout": "1800"
  },
  "common_env": {
    "GIT_CONFIG_GLOBAL": "/opt/data/devflow/gitconfig",
    "GH_PROMPT_DISABLED": "1",
    "GH_NO_UPDATE_NOTIFIER": "1",
    "DBUS_SESSION_BUS_ADDRESS": "disabled:"
  },
  "mattpocock_skills": {
    "repo": "https://github.com/mattpocock/skills",
    "sha": "d65391149dbb5fe76478e76fa8d5122b2aa5a70e"
  },
  "worker_env": {
    "TERMINAL_TIMEOUT": "1800"
  },
  "kanban_dispatcher": {
    "kanban.dispatch_in_gateway": "true",
    "kanban.notify_in_gateway": "true",
    "kanban.review_dispatch": "true",
    "kanban.auto_decompose": "false",
    "kanban.orchestrator_profile": "orchestrator",
    "kanban.default_assignee": "orchestrator",
    "kanban.failure_limit": "3",
    "kanban.max_in_progress": "4",
    "kanban.max_in_progress_per_profile": "2"
  },
  "kanban_other": {
    "kanban.dispatch_in_gateway": "false",
    "kanban.notify_in_gateway": "true",
    "kanban.review_dispatch": "true",
    "kanban.auto_decompose": "false"
  },
  "kanban_unset": ["kanban.dispatch_profiles"],
  "cards": {
    "EPIC": {"assignee": "orchestrator", "workspace": "dir"},
    "ADJ":  {"assignee": "orchestrator", "workspace": "dir"},
    "RES":  {"assignee": "researcher",   "workspace": "scratch"},
    "ARCH": {"assignee": "architect",    "workspace": "dir"},
    "DEV":  {"assignee": "developer",    "workspace": "worktree"},
    "OPS":  {"assignee": "devops",       "workspace": "worktree"},
    "SHIP": {"assignee": "devops",       "workspace": "dir"},
    "ADV":  {"assignee": "default",      "workspace": "scratch"}
  },
  "advisor": {"model": "claude-opus-5.5", "provider": "copilot"},
  "host": {
    "ssh": "",
    "_comment": "實際主機 SSH 目標請設於環境變數 DEVFLOW_HOST_SSH 或執行期 /opt/data/devflow/config.json（host.ssh），不寫死於 kit repo。"
  },
  "decisions": {"url": "https://api.openai.com/v1/decisions", "model": "gpt-6-luna", "flag": 0.5, "pass": 0.8},
  "pstack_always_off": ["setup-pstack", "make-bot-ui", "ketchup-video", "automate-me"],
  "obsolete_skills": {
    "root": ["goal-aligned-advisory", "hermes-talk-project-progress", "repo-evidence-custody",
             "seven-bot-native-workflow-boundaries", "grill-me", "grilling", "seven-pstack-*"],
    "profiles": ["team-operations", "seven-pstack-*", "devflow-contract-upgrade"],
    "codex": ["team-operations", "seven-pstack-*", "test-driven-development", "ub-mode", "pstack/skills/tdd",
              "pstack/skills/principle-fix-root-causes", "pstack/skills/principle-test-behavior-not-implementation"]
  },
  "obsolete_cron_names": ["seven-bot-v1-project-supervision"],
  "obsolete_hooks": [
    {"event": "pre_tool_call", "command": "/opt/data/devflow/bin/devflow stage-card"}
  ],
  "roles": {
    "default": {
      "title": "Hermes",
      "description": "預設 Bot：即時語音（GPT-Live）與文字入口、需求釐清、建立 Epic 卡交給 orchestrator、回報進度，並擔任 Advisor 檢查計畫是否對準使用者目標。不寫產品程式、不部署。",
      "auto_load": ["devflow-intake"],
      "team": ["devflow", "devflow-intake", "devflow-chat", "devflow-cli"],
      "mattpocock": ["grilling", "to-questionnaire"],
      "pstack": ["in-your-own-words", "sharpen", "principle-attack-the-premise", "principle-never-block-on-the-human"],
      "gh": "builder",
      "git_name": "hermes",
      "config": {
        "platform_toolsets.cli": "[hermes-cli, kanban, kanban_query]",
        "platform_toolsets.api_server": "[hermes-api-server, kanban, kanban_query]",
        "voice.voice_chat_mode": "gpt-live",
        "voice.gpt_live.instructions": "一律用台灣腔調的華語說話：台灣口音、台灣用語（影片、軟體、網路、資訊、品質），不用中國大陸口音或用語；語氣自然親切，像台灣同事聊天。用台灣繁體中文口語回答，句子短、先講結論；需要查證或執行的事交給 Hermes 處理後再簡短轉述。轉述 Hermes 的提問時保留題號與建議答案，念完該輪題目就停下來等使用者回答。",
        "hooks_auto_accept": "true",
        "fallback_providers": "[{\"provider\": \"openai-codex\", \"model\": \"gpt-6.1-sol-900k\"}]",
        "hooks.on_kanban_dispatch_tick": "[{\"command\": \"/opt/data/devflow/bin/devflow tick --hook\", \"timeout\": 30}]"
      },
      "worker": false
    },
    "orchestrator": {
      "title": "orchestrator",
      "description": "專案經理：接 Epic 卡、同步 repo、把需求拆成 research/architect/developer/devops 卡並以 parent 串成流程，等待子卡完成後驗收並回報。不寫產品程式。",
      "auto_load": ["devflow", "devflow-orchestrate"],
      "team": ["devflow", "devflow-orchestrate", "devflow-chat", "devflow-cli"],
      "mattpocock": ["to-tickets", "to-spec"],
      "pstack": ["blast-radius", "principle-sequence-verifiable-units",
                 "principle-attack-the-premise", "principle-encode-lessons-in-structure"],
      "gh": "builder",
      "git_name": "hermes-orchestrator",
      "config": {},
      "unset": ["hooks.kanban_task_blocked", "hooks.kanban_task_completed"]
    },
    "researcher": {
      "title": "researcher",
      "description": "技術研究：查官方文件與一手來源、比較方案、做最小可行驗證（PoC），把結論與來源寫回卡片。不改產品 repo。",
      "auto_load": ["devflow", "devflow-research"],
      "team": ["devflow", "devflow-research", "devflow-chat", "devflow-cli"],
      "mattpocock": ["research", "prototype"],
      "pstack": ["principle-explain-the-number", "principle-attack-the-premise"],
      "gh": "builder",
      "git_name": "hermes-researcher",
      "config": {"platform_toolsets.cli": "[terminal, file, code_execution, skills, web, browser, vision]"}
    },
    "architect": {
      "title": "architect",
      "description": "架構設計：新 repo 骨架、模組邊界、資料模型、API 介面、部署拓樸與技術決策（ADR）。在開發前定案跨模組決策，結果寫回卡片給 developer。",
      "auto_load": ["devflow", "devflow-architect"],
      "team": ["devflow", "devflow-architect", "devflow-chat", "devflow-cli"],
      "mattpocock": ["codebase-design", "domain-modeling"],
      "pstack": ["blast-radius", "principle-model-the-domain", "principle-boundary-discipline"],
      "gh": "builder",
      "git_name": "hermes-architect",
      "config": {}
    },
    "developer": {
      "title": "developer",
      "description": "開發：透過 Codex app-server（Codex CLI）在卡片專屬 git worktree 實作與測試，先跑 preflight 再推送分支、開 PR、確認 CI 綠燈後送 review；依 review 意見修正。不合併、不部署。",
      "auto_load": ["devflow", "devflow-develop"],
      "team": ["devflow", "devflow-develop", "devflow-chat", "devflow-cli"],
      "mattpocock": ["tdd", "diagnosing-bugs"],
      "pstack": ["principle-prove-it-works", "create-verification-skill"],
      "codex_skills": [],
      "gh": "builder",
      "git_name": "hermes-developer",
      "config": {
        "model.default": "gpt-6.1-sol",
        "agent.reasoning_effort": "high",
        "model.openai_runtime": "codex_app_server",
        "model.codex_bin": "/opt/data/devflow/bin/codex-developer",
        "approvals.mode": "off"
      }
    },
    "reviewer": {
      "title": "reviewer",
      "description": "獨立審查與 QA：在 review 欄審 PR 的正確性、範圍對齊、驗收對應、安全與回歸，執行針對性快測與獨立探測；通過就完成卡片並在 GitHub approve，否則 request changes 退回 developer。不代寫實作。",
      "auto_load": ["devflow", "devflow-review"],
      "team": ["devflow", "devflow-review", "devflow-chat", "devflow-cli"],
      "mattpocock": ["code-review", "diagnosing-bugs"],
      "pstack": ["blast-radius", "principle-prove-it-works", "principle-minimize-reader-load"],
      "gh": "reviewer",
      "git_name": "hermes-reviewer",
      "plugins": ["github-copilot"],
      "config": {
        "model.default": "claude-opus-5.5",
        "model.provider": "copilot",
        "fallback_providers": "[{\"provider\": \"openai-codex\", \"model\": \"gpt-6.1-sol-900k\"}]"
      },
      "unset": ["model.base_url", "model.api_mode"]
    },
    "devops": {
      "title": "devops",
      "description": "CI/CD 與維運：新 repo 接入（board、clone、workflow、self-hosted runner）、合併已核准 PR、透過 GitHub Actions 部署 Docker 到主機、確認健康檢查與回滾。",
      "auto_load": ["devflow", "devflow-devops"],
      "team": ["devflow", "devflow-devops", "devflow-chat", "devflow-cli"],
      "mattpocock": ["diagnosing-bugs"],
      "pstack": ["blast-radius", "principle-make-operations-idempotent",
                 "principle-explain-the-number", "principle-encode-lessons-in-structure"],
      "gh": "builder",
      "git_name": "hermes-devops",
      "config": {"platform_toolsets.cli": "[terminal, file, code_execution, skills, web, clarify, vision]"}
    }
  }
}
