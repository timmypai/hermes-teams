{
  "_comment": "devflow 角色表：install.py 依此設定 7 個 Hermes profile（default = Hermes）。",
  "gh": {
    "builder": "/opt/data/profiles/devops/gh",
    "reviewer": "/opt/data/profiles/reviewer/gh"
  },
  "worker_config": {
    "agent.max_turns": "400",
    "agent.run_budget_seconds": "null",
    "terminal.timeout": "3600"
  },
  "common_env": {
    "GIT_CONFIG_GLOBAL": "/opt/data/devflow/gitconfig",
    "GH_PROMPT_DISABLED": "1",
    "GH_NO_UPDATE_NOTIFIER": "1"
  },
  "worker_env": {
    "TERMINAL_TIMEOUT": "3600"
  },
  "kanban_dispatcher": {
    "kanban.dispatch_in_gateway": "true",
    "kanban.notify_in_gateway": "true",
    "kanban.review_dispatch": "true",
    "kanban.auto_decompose": "false",
    "kanban.orchestrator_profile": "orchestrator",
    "kanban.default_assignee": "orchestrator",
    "kanban.failure_limit": "3",
    "kanban.max_in_progress": "4",
    "kanban.max_in_progress_per_profile": "2"
  },
  "kanban_other": {
    "kanban.dispatch_in_gateway": "false",
    "kanban.notify_in_gateway": "true",
    "kanban.review_dispatch": "true",
    "kanban.auto_decompose": "false"
  },
  "kanban_unset": ["kanban.dispatch_profiles"],
  "cards": {
    "EPIC": {"assignee": "orchestrator", "workspace": "dir"},
    "ADJ":  {"assignee": "orchestrator", "workspace": "dir"},
    "RES":  {"assignee": "researcher",   "workspace": "scratch"},
    "ARCH": {"assignee": "architect",    "workspace": "dir"},
    "DEV":  {"assignee": "developer",    "workspace": "worktree"},
    "OPS":  {"assignee": "devops",       "workspace": "worktree"},
    "SHIP": {"assignee": "devops",       "workspace": "dir"},
    "ADV":  {"assignee": "default",      "workspace": "scratch"}
  },
  "advisor": {"model": "claude-opus-5.5", "provider": "copilot"},
  "decisions": {"url": "https://api.openai.com/v1/decisions", "model": "gpt-6-luna", "flag": 0.5, "pass": 0.8},
  "pstack_always_off": ["setup-pstack", "make-bot-ui", "ketchup-video", "automate-me"],
  "obsolete_skills": {
    "root": ["goal-aligned-advisory", "hermes-talk-project-progress", "repo-evidence-custody",
             "seven-bot-native-workflow-boundaries", "grill-me", "grilling", "seven-pstack-*"],
    "profiles": ["team-operations", "seven-pstack-*", "devflow-contract-upgrade"],
    "codex": ["team-operations", "seven-pstack-*", "test-driven-development", "pstack/skills/tdd",
              "pstack/skills/principle-fix-root-causes", "pstack/skills/principle-test-behavior-not-implementation"]
  },
  "obsolete_cron_names": ["seven-bot-v1-project-supervision"],
  "roles": {
    "default": {
      "title": "Hermes",
      "description": "預設 Bot：即時語音（GPT-Live）與文字入口、需求釐清、建立 Epic 卡交給 orchestrator、回報進度，並擔任 Advisor 檢查計畫是否對準使用者目標。不寫產品程式、不部署。",
      "auto_load": ["devflow-intake"],
      "team": ["devflow", "devflow-intake"],
      "mattpocock": ["grilling", "grill-me", "to-questionnaire", "wait-what", "teach", "ask-matt"],
      "pstack": ["in-your-own-words", "bro", "ketchup", "how", "why", "teach", "unslop", "sharpen",
                 "principle-attack-the-premise", "principle-experience-first", "principle-never-block-on-the-human"],
      "gh": "builder",
      "git_name": "hermes",
      "config": {
        "platform_toolsets.cli": "[hermes-cli, kanban, kanban_query]",
        "platform_toolsets.api_server": "[hermes-api-server, kanban, kanban_query]",
        "voice.voice_chat_mode": "gpt-live",
        "voice.gpt_live.instructions": "一律用台灣腔調的華語說話：台灣口音、台灣用語（影片、軟體、網路、資訊、品質），不用中國大陸口音或用語；語氣自然親切，像台灣同事聊天。用台灣繁體中文口語回答，句子短、先講結論；需要查證或執行的事交給 Hermes 處理後再簡短轉述。轉述 Hermes 的提問時保留題號與建議答案，念完該輪題目就停下來等使用者回答。",
        "hooks_auto_accept": "true",
        "hooks.on_kanban_dispatch_tick": "[{\"command\": \"/opt/data/devflow/bin/devflow tick --hook\", \"timeout\": 30}]"
      },
      "worker": false
    },
    "orchestrator": {
      "title": "orchestrator",
      "description": "專案經理：接 Epic 卡、同步 repo、把需求拆成 research/architect/developer/devops 卡並以 parent 串成流程，等待子卡完成後驗收並回報。不寫產品程式。",
      "auto_load": ["devflow", "devflow-orchestrate"],
      "team": ["devflow", "devflow-orchestrate"],
      "mattpocock": ["to-tickets", "wayfinder", "to-spec"],
      "pstack": ["figure-it-out", "show-me-your-work", "ketchup", "recall", "sharpen", "blast-radius",
                 "principle-sequence-verifiable-units", "principle-separate-before-serializing-shared-state",
                 "principle-outcome-oriented-execution", "principle-never-block-on-the-human",
                 "principle-attack-the-premise", "principle-subtract-before-you-add",
                 "principle-encode-lessons-in-structure"],
      "gh": "builder",
      "git_name": "hermes-orchestrator",
      "config": {},
      "unset": ["hooks.kanban_task_blocked", "hooks.kanban_task_completed"]
    },
    "researcher": {
      "title": "researcher",
      "description": "技術研究：查官方文件與一手來源、比較方案、做最小可行驗證（PoC），把結論與來源寫回卡片。不改產品 repo。",
      "auto_load": ["devflow", "devflow-research"],
      "team": ["devflow", "devflow-research"],
      "mattpocock": ["research", "prototype"],
      "pstack": ["how", "why", "recall", "benchmark-checklist", "principle-explain-the-number",
                 "principle-exhaust-the-design-space", "principle-attack-the-premise", "unslop"],
      "gh": "builder",
      "git_name": "hermes-researcher",
      "config": {}
    },
    "architect": {
      "title": "architect",
      "description": "架構設計：新 repo 骨架、模組邊界、資料模型、API 介面、部署拓樸與技術決策（ADR）。在開發前定案跨模組決策，結果寫回卡片給 developer。",
      "auto_load": ["devflow", "devflow-architect"],
      "team": ["devflow", "devflow-architect"],
      "mattpocock": ["codebase-design", "domain-modeling", "improve-codebase-architecture", "prototype"],
      "pstack": ["architect", "statechart", "how", "why", "blast-radius",
                 "principle-foundational-thinking", "principle-model-the-domain", "principle-boundary-discipline",
                 "principle-redesign-from-first-principles", "principle-exhaust-the-design-space",
                 "principle-type-system-discipline", "principle-minimize-reader-load"],
      "gh": "builder",
      "git_name": "hermes-architect",
      "config": {}
    },
    "developer": {
      "title": "developer",
      "description": "開發：透過 Codex app-server（Codex CLI）在卡片專屬 git worktree 實作與測試，推送分支、開 PR、確認 CI 綠燈後送 review；依 review 意見修正。不合併、不部署。",
      "auto_load": ["devflow", "devflow-develop"],
      "team": ["devflow", "devflow-develop", "devflow-devops"],
      "mattpocock": ["implement", "tdd", "diagnosing-bugs", "pr"],
      "pstack": ["typescript-best-practices", "unslop", "principle-prove-it-works",
                 "principle-migrate-callers-then-delete-legacy-apis",
                 "create-verification-skill", "maintain-verification-skill"],
      "codex_skills": ["ub-mode"],
      "gh": "builder",
      "git_name": "hermes-developer",
      "config": {
        "model.default": "gpt-6.1-sol",
        "agent.reasoning_effort": "high",
        "model.openai_runtime": "codex_app_server",
        "model.codex_bin": "/opt/data/devflow/bin/codex-developer",
        "approvals.mode": "off"
      }
    },
    "reviewer": {
      "title": "reviewer",
      "description": "獨立審查與 QA：在 review 欄審 PR 的正確性、驗收對應、安全與回歸，實際跑測試；通過就完成卡片並在 GitHub approve，否則 request changes 退回 developer。不代寫實作。",
      "auto_load": ["devflow", "devflow-review"],
      "team": ["devflow", "devflow-review", "ub-mode"],
      "mattpocock": ["code-review", "diagnosing-bugs"],
      "pstack": ["interrogate", "blast-radius", "correct", "unslop",
                 "principle-prove-it-works", "principle-test-behavior-not-implementation",
                 "principle-minimize-reader-load", "principle-fix-root-causes", "principle-boundary-discipline"],
      "gh": "reviewer",
      "git_name": "hermes-reviewer",
      "plugins": ["github-copilot"],
      "config": {
        "model.default": "claude-opus-5.5",
        "model.provider": "copilot",
        "fallback_providers": "[{\"provider\": \"openai-codex\", \"model\": \"gpt-6.1-sol-900k\"}]"
      },
      "unset": ["model.base_url", "model.api_mode"]
    },
    "devops": {
      "title": "devops",
      "description": "CI/CD 與維運：新 repo 接入（board、clone、workflow、self-hosted runner）、合併已核准 PR、透過 GitHub Actions 部署 Docker 到 Oracle VM、確認健康檢查與回滾。",
      "auto_load": ["devflow", "devflow-devops"],
      "team": ["devflow", "devflow-devops"],
      "mattpocock": ["wizard", "diagnosing-bugs", "pr"],
      "pstack": ["blast-radius", "benchmark-checklist",
                 "principle-make-operations-idempotent", "principle-prove-it-works", "principle-build-the-lever",
                 "principle-fix-root-causes", "principle-explain-the-number", "principle-boundary-discipline",
                 "principle-encode-lessons-in-structure",
                 "create-verification-skill", "maintain-verification-skill"],
      "gh": "builder",
      "git_name": "hermes-devops",
      "config": {}
    }
  }
}
