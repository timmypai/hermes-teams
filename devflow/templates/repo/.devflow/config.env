# devflow 設定。部署腳本、CI 與 Bot 都讀這個檔。
DEVFLOW_APP=__APP__
# 主機上綁 127.0.0.1 的埠（devflow repo add 分配，不要和其他 repo 重複）
DEVFLOW_PORT=__PORT__
# 容器內服務監聽的埠
DEVFLOW_APP_PORT=8080
# deploy/compose.yml 的服務名（verify.sh 的瀏覽器容器用 http://<服務名>:<APP_PORT> 連它）。
# 空字串 = 沒有服務（CLI / 函式庫）：CI 不起 compose、health 記 none，只跑 verify.sh 的 shell 情境
# （有 Dockerfile 仍會 build 成 $DEVFLOW_IMAGE 給情境 docker run）。宣告了服務就必須有 Dockerfile。
DEVFLOW_SERVICE=app
# 健康檢查路徑；空字串 = 只檢查容器是否在跑
DEVFLOW_HEALTH_PATH=/health
# false = 不部署（純函式庫、CLI、文件 repo）
DEVFLOW_DEPLOY=true
# true = deploy.yml 只保留手動 workflow_dispatch（merge 不自動部署）
DEVFLOW_DEPLOY_MANUAL_ONLY=false
# 隨 release 快照保存的額外檔案（逗號分隔相對路徑，例：docker/chromium-seccomp.json），供回滾使用
DEVFLOW_RELEASE_FILES=
# PR 合併策略：squash | merge | rebase（不設時預設 squash；需保留 merge commit 驗證的 repo 設 merge）
DEVFLOW_MERGE_METHOD=squash
# 開發者 preflight 與 reviewer 本機快測指令（選填，避免在缺完整依賴的容器跑重型全量測試超時）
DEVFLOW_REVIEW_TEST_CMD=
# 額外保護路徑（逗號分隔 glob，改動時由 preflight 與 check pr 標記 needs_human_approval）
DEVFLOW_PROTECTED_PATHS=
# true = 改動受保護檔時 ship merge 必須先取得 exact-head 人類核准（預設沿用 kit policy）
DEVFLOW_REQUIRE_HUMAN_APPROVAL=
# 單一 PR 預設最大變更檔數上限（不設時沿用 kit policy）
DEVFLOW_MAX_DIFF_FILES=
# 僅特殊授權才設 true；預設 false，所有 repo 一律強制遵循 devflow 公版部署與採證腳本
DEVFLOW_ALLOW_CUSTOM_DELIVERY=false
